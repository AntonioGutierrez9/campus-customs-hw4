# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# .env is ignored by git, so your real keys never get committed.

# Portkey API key used for the chatbot's AI calls (required)
PORTKEY_API_KEY=your-portkey-api-key-here

# Secret that signs login cookies (required). Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# Which model the chatbot uses (optional, default gpt-5.6-luna)
CHAT_MODEL=gpt-5.6-luna
